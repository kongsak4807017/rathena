{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rathena.local/tools/performance/a3/schemas/manifest.schema.json",
  "title": "A3 Reproducibility Manifest",
  "description": "Frozen environment identity for one A3 baseline cycle, exactly as emitted by tools.performance.a3.manifest.capture_manifest(). manifest_sha256 is computed over the canonical JSON serialization (UTF-8, sorted keys, separators (',', ':')) of this document with only the top-level manifest_sha256 field excluded. Capturable fields are nullable so an ineligible manifest (capture failed) can still be frozen; an eligible manifest has no null values.",
  "type": "object",
  "required": [
    "created_utc",
    "sequence",
    "source",
    "build",
    "protocol",
    "rathena_configuration",
    "game_content",
    "database",
    "operating_system",
    "hardware",
    "observability",
    "load_generation",
    "capture_errors",
    "eligible_for_execution",
    "manifest_id",
    "manifest_sha256"
  ],
  "properties": {
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC capture timestamp, e.g. 2026-08-02T19:00:00Z."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Manifest sequence within one capture day; rendered as exactly three digits in manifest_id."
    },
    "source": {
      "type": "object",
      "required": ["repository_url", "branch", "git_commit_sha", "git_short_sha", "working_tree_clean", "submodules"],
      "properties": {
        "repository_url": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "git_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "git_short_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7}$"},
        "working_tree_clean": {"type": ["boolean", "null"]},
        "submodules": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["compiler", "compiler_version", "build_type", "build_flags", "login_server_sha256", "char_server_sha256", "map_server_sha256"],
      "properties": {
        "compiler": {"type": ["string", "null"]},
        "compiler_version": {"type": ["string", "null"]},
        "build_type": {"type": "string"},
        "build_flags": {"type": "string"},
        "login_server_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "char_server_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "map_server_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["packetver", "packet_database_revision"],
      "properties": {
        "packetver": {"type": ["integer", "null"]},
        "packet_database_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "rathena_configuration": {
      "type": "object",
      "required": ["login_config_sha256", "char_config_sha256", "map_config_sha256", "inter_config_sha256", "observability_config_sha256", "slow_sql_threshold", "slow_script_threshold", "snapshot_interval_seconds"],
      "properties": {
        "login_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "char_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "map_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "inter_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "observability_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "slow_sql_threshold": {"type": ["integer", "null"], "description": "Runtime SQL slow threshold in ms from tools/observability/observer.example.json slow_sql_threshold_ms."},
        "slow_script_threshold": {"type": ["integer", "null"], "description": "Runtime script slow threshold in ms from tools/observability/observer.example.json slow_script_threshold_ms."},
        "snapshot_interval_seconds": {"type": "integer", "const": 5}
      },
      "additionalProperties": false
    },
    "game_content": {
      "type": "object",
      "required": ["script_tree_sha256", "npc_content_sha256", "item_database_sha256", "monster_database_sha256", "skill_database_sha256", "map_index_sha256"],
      "properties": {
        "script_tree_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "npc_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "item_database_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "monster_database_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "skill_database_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "map_index_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["mariadb_version", "my_cnf_sha256", "schema_revision", "schema_sha256", "dataset_seed", "dataset_sha256", "row_counts"],
      "properties": {
        "mariadb_version": {"type": ["string", "null"]},
        "my_cnf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "schema_revision": {"type": ["string", "null"]},
        "schema_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "dataset_seed": {"type": "integer"},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_counts": {
          "type": "object",
          "required": ["accounts", "characters", "guilds", "parties"],
          "properties": {
            "accounts": {"type": "integer"},
            "characters": {"type": "integer"},
            "guilds": {"type": "integer"},
            "parties": {"type": "integer"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operating_system": {
      "type": "object",
      "required": ["distribution", "distribution_version", "kernel_version", "package_snapshot_sha256", "filesystem_type", "mount_options", "timezone", "time_sync_source"],
      "properties": {
        "distribution": {"type": ["string", "null"]},
        "distribution_version": {"type": ["string", "null"]},
        "kernel_version": {"type": ["string", "null"]},
        "package_snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "filesystem_type": {"type": ["string", "null"]},
        "mount_options": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]},
        "time_sync_source": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": ["cpu_model", "physical_cores", "logical_threads", "ram_bytes", "nvme_model", "nvme_firmware", "nic_model", "link_speed_mbps", "bios_version", "cpu_governor", "bios_power_profile", "numa_topology"],
      "properties": {
        "cpu_model": {"type": ["string", "null"]},
        "physical_cores": {"type": ["integer", "null"]},
        "logical_threads": {"type": ["integer", "null"]},
        "ram_bytes": {"type": ["integer", "null"]},
        "nvme_model": {"type": ["string", "null"]},
        "nvme_firmware": {"type": ["string", "null"]},
        "nic_model": {"type": ["string", "null"]},
        "link_speed_mbps": {"type": ["integer", "null"]},
        "bios_version": {"type": ["string", "null"]},
        "cpu_governor": {"type": ["string", "null"]},
        "bios_power_profile": {"type": ["string", "null"]},
        "numa_topology": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": ["prometheus_version", "node_exporter_version", "mariadb_exporter_version", "scrape_config_sha256", "grafana_version", "grafana_dashboard_sha256"],
      "properties": {
        "prometheus_version": {"type": ["string", "null"]},
        "node_exporter_version": {"type": ["string", "null"]},
        "mariadb_exporter_version": {"type": ["string", "null"]},
        "scrape_config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "grafana_version": {"type": ["string", "null"]},
        "grafana_dashboard_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "load_generation": {
      "type": "object",
      "required": ["harness_repository", "harness_commit_sha", "harness_binary_sha256", "workload_profile_sha256", "account_range", "random_seed", "webgl_client_revision"],
      "properties": {
        "harness_repository": {"type": "string"},
        "harness_commit_sha": {"type": ["string", "null"]},
        "harness_binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "workload_profile_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "account_range": {"type": "string"},
        "random_seed": {"type": "integer"},
        "webgl_client_revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "capture_errors": {
      "type": "array",
      "description": "Structured capture failures. A non-empty list makes the manifest ineligible for execution.",
      "items": {
        "type": "object",
        "required": ["command", "field", "return_code", "stderr"],
        "properties": {
          "command": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Argument array exactly as executed (never a shell string)."
          },
          "field": {"type": "string", "description": "Dotted manifest field affected by the failure."},
          "return_code": {"type": ["integer", "null"], "description": "Process exit code, or null when the command timed out or could not start."},
          "stderr": {"type": "string", "description": "Truncated stderr summary (max 200 characters)."},
          "timeout": {"type": "integer", "description": "Timeout in seconds; present only for timed-out commands."}
        },
        "additionalProperties": false
      }
    },
    "eligible_for_execution": {
      "type": "boolean",
      "description": "True only when capture_errors is empty."
    },
    "manifest_id": {
      "type": ["string", "null"],
      "pattern": "^a3-\\d{8}-[0-9a-f]{7}-ubuntu2404-8c16t-32g-\\d{3}$",
      "description": "Null only for an ineligible manifest where capture failed."
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
